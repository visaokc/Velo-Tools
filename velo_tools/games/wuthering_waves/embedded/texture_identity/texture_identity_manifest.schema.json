{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texture-identity-manifest:schema:v1",
  "title": "Compact r16 texture identity manifest",
  "type": "object",
  "required": [
    "schema_version",
    "textures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "textures": {
      "type": "object",
      "patternProperties": {
        "^[0-9a-f]{8}$": {
          "type": "object",
          "required": [
            "fingerprint",
            "format"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^v3:r16:rgba8-phash:"
            },
            "format": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
