{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texture-identity-manifest:schema:v7",
  "title": "Texture identity manifest",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "algorithm",
    "source",
    "runtime_contract",
    "identities"
  ],
  "properties": {
    "$schema": {
      "const": "urn:texture-identity-manifest:schema:v7"
    },
    "schema": {
      "const": "texture-identity-manifest"
    },
    "schema_version": {
      "const": 7
    },
    "algorithm": {
      "type": "object",
      "required": [
        "name",
        "version",
        "canonical_color_domain",
        "canonical_view_policy",
        "mip_selection_policy",
        "minimum_streaming_extent",
        "streaming_simulation",
        "candidate_resolutions",
        "payload",
        "payload_bytes",
        "payload_profile",
        "distance",
        "distance_weights",
        "minimum_margin_policy",
        "minimum_margin_safety_factor",
        "preferred_minimum_match_margin",
        "effective_tolerance",
        "selection_rule",
        "reference_strategy"
      ],
      "properties": {
        "name": {
          "const": "canonical-pixel-fingerprint"
        },
        "version": {
          "const": 3
        },
        "canonical_color_domain": {
          "const": "encoded-rgba8"
        },
        "canonical_view_policy": {
          "const": "compatible-non-srgb-srv"
        },
        "mip_selection_policy": {
          "const": "simulated-streaming-chain-to-256-area-average-v3"
        },
        "minimum_streaming_extent": {
          "const": 256
        },
        "streaming_simulation": {
          "const": "recursive-encoded-rgba8-area-average-with-level-quantization"
        },
        "candidate_resolutions": {
          "const": [
            16
          ]
        },
        "payload": {
          "const": "v3:r16:rgba8-phash:<base64url>"
        },
        "payload_profile": {
          "const": "rgba8-phash"
        },
        "payload_bytes": {
          "const": 41
        },
        "distance": {
          "const": "weighted-channel-phash-statistics-v3"
        },
        "distance_weights": {
          "const": {
            "channel_phash_hamming": 0.064,
            "mean_mae": 0.15,
            "deviation_mae": 0.07,
            "alpha_coverage_absolute": 0.03
          }
        },
        "minimum_margin_policy": {
          "const": "observed_minimum_classification_margin * safety_factor"
        },
        "minimum_margin_safety_factor": {
          "const": 0.25
        },
        "preferred_minimum_match_margin": {
          "const": 0.002
        },
        "effective_tolerance": {
          "type": "string"
        },
        "selection_rule": {
          "const": "use the single exact r16 standard anchor"
        },
        "reference_strategy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "resource_origin",
        "profile",
        "allowed_profiles",
        "lod_dump_policy",
        "image_source"
      ],
      "properties": {
        "resource_origin": {
          "const": "original-game-dump"
        },
        "profile": {
          "enum": [
            "extracted-object",
            "Showcase1",
            "Dungeon1",
            "Dungeon2"
          ]
        },
        "allowed_profiles": {
          "const": [
            "extracted-object",
            "Showcase1",
            "Dungeon1",
            "Dungeon2"
          ]
        },
        "lod_dump_policy": {
          "const": "not-used-as-a-manifest-generation-gate"
        },
        "image_source": {
          "const": "dump-top-level-dds-image"
        }
      },
      "additionalProperties": true
    },
    "runtime_contract": {
      "type": "object",
      "required": [
        "prototype_abi_version",
        "runtime_fingerprint_algorithm_version",
        "abi_reference",
        "abi_field_status",
        "cache_key",
        "match_resolutions",
        "match_format_families",
        "collision_group_default",
        "collision_policies",
        "candidate_context_abi_status",
        "abi_status",
        "abi_blockers",
        "identity_counts"
      ],
      "properties": {
        "prototype_abi_version": {
          "const": 3
        },
        "runtime_fingerprint_algorithm_version": {
          "const": 3
        },
        "abi_reference": {
          "const": "texture-role-v3"
        },
        "abi_field_status": {
          "const": "aligned"
        },
        "cache_key": {
          "const": [
            "resource",
            "resource_version",
            "algorithm_version",
            "payload_profile",
            "resolution",
            "canonical_format",
            "absolute_mip"
          ]
        },
        "match_resolutions": {
          "const": [
            16
          ]
        },
        "match_format_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collision_group_default": {
          "const": "default-r{resolution}-{descriptor_family}"
        },
        "collision_policies": {
          "const": [
            "reject",
            "merge",
            "require_draw_context"
          ]
        },
        "candidate_context_abi_status": {
          "const": "evidence-only-unmapped"
        },
        "fingerprint_binding": {
          "const": "native-textureoverride-inline-fingerprint"
        },
        "abi_status": {
          "const": "blocked"
        },
        "abi_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity_counts": {
          "type": "object",
          "required": [
            "total",
            "payload_ready_runtime_blocked",
            "blocked_decoder",
            "runtime_compatible"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "payload_ready_runtime_blocked": {
              "type": "integer",
              "minimum": 0
            },
            "blocked_decoder": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_compatible": {
              "const": 0
            }
          }
        }
      },
      "additionalProperties": true
    },
    "identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "identity",
        "legacy_resource_hash",
        "fingerprint_status",
        "variants",
        "candidate_contexts",
        "witnesses"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "legacy_resource_hash": {
          "type": "string"
        },
        "fingerprint_status": {
          "enum": [
            "payload-ready-runtime-blocked",
            "source-retained-blocked-decoder"
          ]
        },
        "fingerprint_error": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "candidate_contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_context"
          }
        },
        "witnesses": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "variant": {
      "type": "object",
      "required": [
        "variant",
        "context_ref",
        "stable_resource_ref",
        "fingerprint_source_ref",
        "source_sha256",
        "width",
        "height",
        "mips",
        "format",
        "format_family",
        "source_is_srgb",
        "fingerprints"
      ],
      "properties": {
        "variant": {
          "type": "string"
        },
        "context_ref": {
          "type": "string"
        },
        "stable_resource_ref": {
          "type": "string"
        },
        "fingerprint_source_ref": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "mips": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string"
        },
        "format_family": {
          "type": "string"
        },
        "source_is_srgb": {
          "type": "boolean"
        },
        "fingerprints": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "16"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/fingerprint_record"
          }
        }
      },
      "additionalProperties": true
    },
    "fingerprint_record": {
      "type": "object",
      "properties": {
        "status": {
          "const": "payload-ready"
        },
        "algorithm_version": {
          "const": 3
        },
        "payload_profile": {
          "const": "rgba8-phash"
        },
        "canonical_color_domain": {
          "const": "encoded-rgba8"
        },
        "canonical_view_policy": {
          "const": "compatible-non-srgb-srv"
        },
        "canonical_resolution": {
          "enum": [
            16
          ]
        },
        "canonical_format": {
          "type": "string"
        },
        "payload": {
          "type": "string",
          "pattern": "^v3:r16:rgba8-phash:[A-Za-z0-9_-]{55}=$"
        },
        "absolute_mip": {
          "type": "integer",
          "minimum": 0
        },
        "source_mip_width": {
          "type": "integer",
          "minimum": 1
        },
        "source_mip_height": {
          "type": "integer",
          "minimum": 1
        },
        "source_mip_role": {
          "const": "dump-top-level-image"
        },
        "runtime_source_mip_role": {
          "const": "srv-visible-most-detailed"
        },
        "mip_selection_policy": {
          "const": "simulated-streaming-chain-to-256-area-average-v3"
        },
        "minimum_streaming_extent": {
          "const": 256
        },
        "streaming_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/streaming_variant"
          }
        },
        "payload_abi_compatible": {
          "const": true
        },
        "runtime_compatible": {
          "const": false
        },
        "runtime_compatibility_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offline_cache_identity": {
          "type": "object",
          "required": [
            "resource_version",
            "algorithm_version",
            "payload_profile",
            "resolution",
            "canonical_format",
            "absolute_mip"
          ],
          "properties": {
            "resource_version": {
              "type": "string"
            },
            "algorithm_version": {
              "const": 3
            },
            "payload_profile": {
              "const": "rgba8-phash"
            },
            "resolution": {
              "enum": [
                16,
                32,
                64,
                128,
                256
              ]
            },
            "canonical_format": {
              "type": "string"
            },
            "absolute_mip": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "status",
        "algorithm_version",
        "payload_profile",
        "canonical_color_domain",
        "canonical_view_policy",
        "canonical_resolution",
        "canonical_format",
        "declared_mips",
        "available_complete_mips",
        "mip_chain_complete",
        "mip_selection_policy",
        "source_is_srgb",
        "payload_abi_compatible",
        "runtime_compatible",
        "payload",
        "absolute_mip",
        "source_mip_width",
        "source_mip_height",
        "source_mip_role",
        "runtime_source_mip_role",
        "minimum_streaming_extent",
        "streaming_variants",
        "runtime_compatibility_blockers",
        "offline_cache_identity"
      ],
      "additionalProperties": true
    },
    "streaming_variant": {
      "type": "object",
      "required": [
        "variant",
        "width",
        "height",
        "simulated",
        "payload"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "simulated": {
          "type": "boolean"
        },
        "payload": {
          "type": "string",
          "pattern": "^v3:r16:rgba8-phash:[A-Za-z0-9_-]{55}=$"
        }
      },
      "additionalProperties": false
    },
    "candidate_context": {
      "type": "object",
      "required": [
        "context_id",
        "identity",
        "variant",
        "vb0_hashes",
        "ib_hashes",
        "components",
        "draws",
        "bindings"
      ],
      "properties": {
        "context_id": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "vb0_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ib_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "draws": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
