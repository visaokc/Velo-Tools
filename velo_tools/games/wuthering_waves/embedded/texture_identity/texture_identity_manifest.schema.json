{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texture-identity-manifest:schema:v3",
  "title": "Texture identity manifest",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "algorithm",
    "source",
    "runtime_contract",
    "identities"
  ],
  "properties": {
    "$schema": {
      "const": "urn:texture-identity-manifest:schema:v3"
    },
    "schema": {
      "const": "texture-identity-manifest"
    },
    "schema_version": {
      "const": 3
    },
    "algorithm": {
      "type": "object",
      "required": [
        "name",
        "version",
        "canonical_color_domain",
        "canonical_view_policy",
        "mip_selection_policy",
        "candidate_resolutions",
        "payload",
        "distance",
        "effective_tolerance",
        "selection_rule",
        "reference_strategy"
      ],
      "properties": {
        "name": {
          "const": "canonical-pixel-fingerprint"
        },
        "version": {
          "const": 3
        },
        "canonical_color_domain": {
          "const": "encoded-rgba8"
        },
        "canonical_view_policy": {
          "const": "compatible-non-srgb-srv"
        },
        "mip_selection_policy": {
          "const": "visible-exact-square-absolute-mip-v3"
        },
        "candidate_resolutions": {
          "const": [
            16,
            32,
            64,
            128,
            256
          ]
        },
        "payload": {
          "const": "v3:rN:rgba8-zlib:<base64url>"
        },
        "distance": {
          "const": "normalized-encoded-rgba8-mean-absolute-error"
        },
        "effective_tolerance": {
          "type": "string"
        },
        "selection_rule": {
          "type": "string"
        },
        "reference_strategy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object"
    },
    "runtime_contract": {
      "type": "object",
      "required": [
        "prototype_abi_version",
        "runtime_fingerprint_algorithm_version",
        "abi_reference",
        "abi_field_status",
        "cache_key",
        "match_resolutions",
        "match_format_families",
        "collision_group_default",
        "collision_policies",
        "candidate_context_abi_status",
        "abi_status",
        "abi_blockers",
        "identity_counts"
      ],
      "properties": {
        "prototype_abi_version": {
          "const": 3
        },
        "runtime_fingerprint_algorithm_version": {
          "const": 3
        },
        "abi_reference": {
          "const": "texture-role-v3"
        },
        "abi_field_status": {
          "const": "aligned"
        },
        "cache_key": {
          "const": [
            "resource",
            "resource_version",
            "algorithm_version",
            "resolution",
            "canonical_format",
            "absolute_mip"
          ]
        },
        "match_resolutions": {
          "const": [
            16,
            32,
            64,
            128,
            256
          ]
        },
        "match_format_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collision_group_default": {
          "const": "default-r{resolution}-{descriptor_family}"
        },
        "collision_policies": {
          "const": [
            "reject",
            "merge",
            "require_draw_context"
          ]
        },
        "candidate_context_abi_status": {
          "const": "evidence-only-unmapped"
        },
        "abi_status": {
          "const": "blocked"
        },
        "abi_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity_counts": {
          "type": "object",
          "required": [
            "total",
            "payload_ready_runtime_blocked",
            "blocked_decoder",
            "blocked_no_exact_square_mip",
            "runtime_compatible"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "payload_ready_runtime_blocked": {
              "type": "integer",
              "minimum": 0
            },
            "blocked_decoder": {
              "type": "integer",
              "minimum": 0
            },
            "blocked_no_exact_square_mip": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_compatible": {
              "const": 0
            }
          }
        }
      },
      "additionalProperties": true
    },
    "identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "identity",
        "legacy_resource_hash",
        "fingerprint_status",
        "variants",
        "candidate_contexts",
        "witnesses"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "legacy_resource_hash": {
          "type": "string"
        },
        "fingerprint_status": {
          "enum": [
            "payload-ready-runtime-blocked",
            "blocked-no-exact-square-mip",
            "source-retained-blocked-decoder"
          ]
        },
        "fingerprint_error": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "candidate_contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_context"
          }
        },
        "witnesses": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "variant": {
      "type": "object",
      "required": [
        "variant",
        "context_ref",
        "stable_resource_ref",
        "fingerprint_source_ref",
        "source_sha256",
        "width",
        "height",
        "mips",
        "format",
        "format_family",
        "source_is_srgb",
        "fingerprints"
      ],
      "properties": {
        "variant": {
          "type": "string"
        },
        "context_ref": {
          "type": "string"
        },
        "stable_resource_ref": {
          "type": "string"
        },
        "fingerprint_source_ref": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "mips": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string"
        },
        "format_family": {
          "type": "string"
        },
        "source_is_srgb": {
          "type": "boolean"
        },
        "fingerprints": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "16",
              "32",
              "64",
              "128",
              "256"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/fingerprint_record"
          }
        }
      },
      "additionalProperties": true
    },
    "fingerprint_record": {
      "type": "object",
      "required": [
        "status",
        "algorithm_version",
        "canonical_color_domain",
        "canonical_view_policy",
        "canonical_resolution",
        "canonical_format",
        "declared_mips",
        "available_complete_mips",
        "mip_chain_complete",
        "mip_selection_policy",
        "source_is_srgb",
        "payload_abi_compatible",
        "runtime_compatible"
      ],
      "properties": {
        "status": {
          "enum": [
            "payload-ready",
            "unavailable"
          ]
        },
        "algorithm_version": {
          "const": 3
        },
        "canonical_color_domain": {
          "const": "encoded-rgba8"
        },
        "canonical_view_policy": {
          "const": "compatible-non-srgb-srv"
        },
        "canonical_resolution": {
          "enum": [
            16,
            32,
            64,
            128,
            256
          ]
        },
        "canonical_format": {
          "type": "string"
        },
        "payload": {
          "type": "string",
          "pattern": "^v3:r(16|32|64|128|256):rgba8-zlib:[A-Za-z0-9_-]+={0,2}$"
        },
        "absolute_mip": {
          "type": "integer",
          "minimum": 0
        },
        "source_mip_width": {
          "type": "integer",
          "minimum": 1
        },
        "source_mip_height": {
          "type": "integer",
          "minimum": 1
        },
        "srv_visibility_status": {
          "const": "unproven"
        },
        "unavailable_reason": {
          "const": "no-exact-square-mip"
        },
        "payload_abi_compatible": {
          "type": "boolean"
        },
        "runtime_compatible": {
          "const": false
        },
        "runtime_compatibility_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offline_cache_identity": {
          "type": "object",
          "required": [
            "resource_version",
            "algorithm_version",
            "resolution",
            "canonical_format",
            "absolute_mip"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "payload-ready"
              }
            }
          },
          "then": {
            "required": [
              "payload",
              "absolute_mip",
              "source_mip_width",
              "source_mip_height",
              "srv_visibility_status",
              "runtime_compatibility_blockers",
              "offline_cache_identity"
            ],
            "properties": {
              "payload_abi_compatible": {
                "const": true
              }
            }
          },
          "else": {
            "required": [
              "unavailable_reason"
            ],
            "properties": {
              "payload_abi_compatible": {
                "const": false
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "candidate_context": {
      "type": "object",
      "required": [
        "context_id",
        "identity",
        "variant",
        "vb0_hashes",
        "ib_hashes",
        "components",
        "draws",
        "bindings"
      ],
      "properties": {
        "context_id": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "vb0_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ib_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "draws": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
